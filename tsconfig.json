{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "NodeNext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "strict": false,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
