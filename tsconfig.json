{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "NodeNext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "./dist",
    "strict": false,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "typedocOptions": {
    "entryPoints": [
      "./src/collections/index.ts",
      "./src/decimal/index.ts",
      "./src/functools/index.ts",
      "./src/globals/index.ts",
      "./src/i18n/index.ts",
      "./src/itertools/index.ts",
      "./src/math/index.ts",
      "./src/operators/index.ts",
      "./src/random/index.ts",
      "./src/string/index.ts",
    ],
    "out": "../atomic-stack.github.io/atomic-fns",
    "exclude": [
      "node_modules"
    ],
    "excludeExternals": true,
    "excludePrivate": true,
  }
}
